anchor=top-right
text-alignment=left
width=400
max-history=10
sort=-time

on-button-left=invoke-default-action
on-button-middle=exec makoctl menu -n $id bemenu -p 'Select action: '
on-button-right=dismiss

max-visible=10
font=Berkeley Mono 9
max-icon-size=38
icon-location=left
margin=6
padding=12
format=<b>%s</b>\n\n%b

background-color=#040606
border-size=2
border-radius=0
default-timeout=10000

[urgency=low]
text-color=#7a85a6
border-color=#2b344d
default-timeout=10000


[urgency=normal]
text-color=#e8f0f8
border-color=#4d5772
default-timeout=10000


[urgency=critical]
text-color=#e8f0f8
border-color=#e05a6add
default-timeout=0

