set shell zsh
set shellopts '-eu'
# Netrunner, see ~/.themes/Netrunner and ~/.config/ghostty/themes/netrunner.conf
#   38;2;43;52;77      $lineHi    #2b344d   pane borders
#   38;2;77;87;114     $dim       #4d5772   line numbers
#   38;2;122;133;166   $muted     #7a85a6   user@host, parent cursor
#   38;2;232;240;248   $text      #e8f0f8   default foreground
#   48;2;18;23;38      $panelHi   #121726   cursor line background
#   38;2;110;134;224   $blue      #6e86e0   directory path, permissions
#   38;2;134;200;220   $cyanLt    #86c8dc   modification time
#   38;2;138;104;200   $violet    #8a68c8   link targets
#   38;2;180;146;236   $violetLt  #b492ec   tags
#   38;2;224;168;104   $amber     #e0a868   cursor, current file, selection
#   38;2;72;184;120    $ok        #48b878   files marked for copying
#   38;2;224;90;106    $bad       #e05a6a   errors, files marked for cutting

set promptfmt "\033[38;2;122;133;166m%u@%h\033[0m:\033[1;38;2;110;134;224m%d\033[0m\033[1;38;2;224;168;104m%f\033[0m"
set ifs "\n"
set scrolloff 10
set drawbox
set borderfmt "\033[38;2;43;52;77m"
set ratios '1:2:3'

# The cursor line repeats the focused window title from sway: amber on the
# panel background, muted in the panes that only show a parent directory.
set cursoractivefmt "\033[48;2;18;23;38;38;2;224;168;104m"
set cursorparentfmt "\033[48;2;18;23;38;38;2;122;133;166m"
set cursorpreviewfmt "\033[48;2;18;23;38m"

set copyfmt "\033[48;2;72;184;120;38;2;5;6;10m"
set cutfmt "\033[48;2;224;90;106;38;2;5;6;10m"
set selectfmt "\033[48;2;224;168;104;38;2;5;6;10m"
set tagfmt "\033[38;2;180;146;236m"
set errorfmt "\033[48;2;224;90;106;38;2;232;240;248m"
set numberfmt "\033[38;2;77;87;114m"

# statfmt only takes effect once rulerfmt is set, so both are spelled out.
set statfmt "\033[38;2;110;134;224m%p\033[0m| %c| \033[38;2;224;168;104m%u\033[0m| %g| \033[38;2;232;240;248m%S\033[0m| \033[38;2;134;200;220m%t\033[0m| -> \033[38;2;138;104;200m%l\033[0m"
set rulerfmt "\033[38;2;224;168;104m%a\033[0m| %p| \033[38;2;72;184;120m%c\033[0m| \033[38;2;224;90;106m%m\033[0m| \033[38;2;224;168;104m%s\033[0m| \033[38;2;180;146;236m%f\033[0m| %i/%t| %P| %d"
set icons
set mouse false
set sixel false
set tabstop 4

map <enter> shell

# execute file
map x $$f
map X !$f

# open file
#map o &mimeopen $f
#map O $mimeopen --ask $f

set previewer ~/.config/lf/scope.wrapper.sh
map i $LESSOPEN='| ~/.config/lf/scope.wrapper.sh %s' less -R $f

cmd open ${{
  test -L $f && f=$(readlink -f $f)
  case $(file --mime-type $f -b) in
    text/*) $EDITOR $f;;
    image/gif) swayimg $f;;
    image/*) imv $f;;
    video/*) vlc $f;;
    *) for f in $fx; do setsid $OPENER $f > /dev/null 2> /dev/null & done;;
  esac
}}

# make sure trash folder exists
%mkdir -p ~/.local/share/Trash

# move current file or selected files to trash folder
cmd trash %set -f; mv "$fx" ~/.local/share/Trash

map <delete> trash
# map <delete> delete

cmd temp %set -f; mv "$fx" ~/cloud/temp/
map T temp

cmd memes %set -f; mv "$fx" ~/cloud/photos/memes/
map \# memes

# Toggle hidden files
map . set hidden!

cmd z %{{
  result="$(zoxide query --exclude "$PWD" "$@" | sed 's/\\/\\\\/g;s/"/\\"/g')"
  lf -remote "send $id cd \"$result\""
}}

cmd zi ${{
  result="$(zoxide query -i | sed 's/\\/\\\\/g;s/"/\\"/g')"
  lf -remote "send $id cd \"$result\""
}}

cmd on-cd &{{
  zoxide add "$PWD"
}}

# extract the current file with the right command
# (xkcd link: https://xkcd.com/1168/)
cmd extract ${{
  set -f
  case $f in
    *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf $f;;
    *.tar.gz|*.tgz) tar xzvf $f;;
    *.tar.xz|*.txz) tar xJvf $f;;
    *.zip) unzip $f;;
    *.rar) unrar x $f;;
    *.7z) 7z x $f;;
  esac
}}

# compress current file or selected files with tar and gunzip
cmd tar ${{
  set -f
  mkdir $1
  cp -r $fx $1
  tar czf $1.tar.gz $1
  rm -rf $1
}}

# compress current file or selected files with zip
cmd zip ${{
  set -f
  mkdir $1
  cp -r $fx $1
  zip -r $1.zip $1
  rm -rf $1
}}
