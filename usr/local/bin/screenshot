#!/bin/sh

shotname='screenshot_%Y-%m-%d-%H%M%S.png'
shotpath="$HOME/cloud/photos/screenshots/$(date +$shotname)"

case "$1" in
"region")
	slurp | grim -t png -g - "$shotpath"
	;;
"window")
	swaymsg -t get_tree |
		jq -r '.. | select(.pid? and .visible?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' |
		slurp |
		grim -t png -g - "$shotpath"
	;;
"screen")
	slurp -o | grim -t png -g - "$shotpath"
	;;
*)
	grim -t png "$shotpath"
	;;
esac
